<p style="color: green"><%= notice %></p>

<h1>Books</h1>
<div id="books" class="index-items">
  <% @books.each do |book| %>
    <div class="index-item">
      <%= render book %>
      <p>
        <nav class="page-nav">
          <%= link_to t(".show"), book %>
        </nav>
      </p>
    </div>
  <% end %>
</div>

<%= link_to(t("new_book"), new_book_path) %>
